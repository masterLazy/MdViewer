<UserControl x:Class="MdViewer.Markdown"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:MdViewer"
             xmlns:wpf="clr-namespace:TheArtOfDev.HtmlRenderer.WPF;assembly=HtmlRenderer.WPF"
             mc:Ignorable="d"
             x:Name="root">
    <wpf:HtmlPanel Width="{Binding ElementName=root, Path=Width}"
                Height="{Binding ElementName=root, Path=Height}"
                x:Name="HtmlPanel"/>
</UserControl>
